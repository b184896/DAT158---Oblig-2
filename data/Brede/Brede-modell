
import pandas as pd

from sklearn.ensemble import ExtraTreesRegressor, RandomForestRegressor
from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OneHotEncoder
from sklearn.metrics import mean_absolute_error, root_mean_squared_error

df = pd.read_csv("data/vehicles.csv")

target = "price"

features = [
    "year",
    "manufacturer",
    "model",
    "condition",
    "cylinders",
    "fuel",
    "odometer",
    "title_status",
    "transmission",
    "drive",
    "size",
    "type",
    "paint_color",
]


required_columns = features + [target]

missing_columns = [
    col for col in required_columns if col not in df.columns
]

if missing_columns:
    raise ValueError(
        f"Disse kolonnene mangler i datasettet: {missing_columns}"
    )

print("\nPrisfordeling før filtrering:")
print(
    df[target].describe(
        percentiles=[0.50, 0.75, 0.90, 0.95, 0.99, 0.995]
    )
)

print("\nAntall annonser over ulike prisgrenser:")

for grense in [50_000, 100_000, 200_000, 500_000, 1_000_000]:
    antall = (df[target] > grense).sum()
    print(f"Over {grense:>9,} USD: {antall:>7,} annonser")


df = df.dropna(subset=[target]).copy()
df = df[df[target].between(500, 100_000)].copy()

print(f"\nAnnonser etter prisfiltrering: {len(df):,}")

sample_size = 30_000

df = df.sample(
    n=min(sample_size, len(df)),
    random_state=42
).copy()

print(f"Annonser brukt i modellene: {len(df):,}")


x = df[features]
y = df[target]

x_train, x_test, y_train, y_test = train_test_split(
    x,
    y,
    test_size=0.2,
    random_state=42
)

print(f"Treningsannonser: {len(x_train):,}")
print(f"Testannonser:     {len(x_test):,}")


numerical_features = [
    "year",
    "odometer",
]

categorical_features = [
    col for col in features
    if col not in numerical_features
]


numerical_transformer = Pipeline([
    (
        "imputer",
        SimpleImputer(strategy="median")
    ),
])

categorical_transformer = Pipeline([
    (
        "imputer",
        SimpleImputer(strategy="most_frequent")
    ),
    (
        "encoder",
        OneHotEncoder(
            handle_unknown="ignore",
            min_frequency=10
        )
    ),
])

preprocessor = ColumnTransformer([
    (
        "num",
        numerical_transformer,
        numerical_features
    ),
    (
        "cat",
        categorical_transformer,
        categorical_features
    ),
])


model = Pipeline([
    ("preprocessor", preprocessor),
    (
        "regressor",
        RandomForestRegressor(
            n_estimators=300,
            max_depth=25,
            min_samples_split=10,
            min_samples_leaf=5,
            max_features=0.7,
            random_state=42,
            n_jobs=-1
        )
    ),
])


print("\nTrener Random Forest-modellen...")

model.fit(x_train, y_train)

print("Random Forest-trening fullført.")


train_predictions = model.predict(x_train)
test_predictions = model.predict(x_test)

train_mae = mean_absolute_error(
    y_train,
    train_predictions
)

train_rmse = root_mean_squared_error(
    y_train,
    train_predictions
)

test_mae = mean_absolute_error(
    y_test,
    test_predictions
)

test_rmse = root_mean_squared_error(
    y_test,
    test_predictions
)

print("\n========== RANDOM FOREST-RESULTATER ==========")

print("\nTreningssett:")
print(f"MAE:  {train_mae:,.0f} USD")
print(f"RMSE: {train_rmse:,.0f} USD")

print("\nTestsett:")
print(f"MAE:  {test_mae:,.0f} USD")
print(f"RMSE: {test_rmse:,.0f} USD")

print("\nForskjell mellom trening og test:")
print(f"MAE-forskjell:  {test_mae - train_mae:,.0f} USD")
print(f"RMSE-forskjell: {test_rmse - train_rmse:,.0f} USD")


extra_trees_model = Pipeline([
    ("preprocessor", preprocessor),
    (
        "regressor",
        ExtraTreesRegressor(
            n_estimators=300,
            min_samples_split=10,
            min_samples_leaf=5,
            max_features=0.7,
            random_state=42,
            n_jobs=-1
        )
    ),
])

print("\nTrener Extra Trees-modellen...")

extra_trees_model.fit(x_train, y_train)

print("Extra Trees-trening fullført.")


extra_train_predictions = extra_trees_model.predict(x_train)
extra_test_predictions = extra_trees_model.predict(x_test)

extra_train_mae = mean_absolute_error(
    y_train,
    extra_train_predictions
)

extra_test_mae = mean_absolute_error(
    y_test,
    extra_test_predictions
)

extra_train_rmse = root_mean_squared_error(
    y_train,
    extra_train_predictions
)

extra_test_rmse = root_mean_squared_error(
    y_test,
    extra_test_predictions
)


print("\n========== MODELLSAMMENLIGNING ==========")

print("\nRandom Forest:")
print(f"Trening MAE:  {train_mae:,.0f} USD")
print(f"Test MAE:     {test_mae:,.0f} USD")
print(f"Trening RMSE: {train_rmse:,.0f} USD")
print(f"Test RMSE:    {test_rmse:,.0f} USD")

print("\nExtra Trees:")
print(f"Trening MAE:  {extra_train_mae:,.0f} USD")
print(f"Test MAE:     {extra_test_mae:,.0f} USD")
print(f"Trening RMSE: {extra_train_rmse:,.0f} USD")
print(f"Test RMSE:    {extra_test_rmse:,.0f} USD")

if extra_test_mae < test_mae:
    best_model = extra_trees_model
    best_model_name = "Extra Trees Regressor"
    best_test_mae = extra_test_mae
    best_test_rmse = extra_test_rmse
else:
    best_model = model
    best_model_name = "Random Forest Regressor"
    best_test_mae = test_mae
    best_test_rmse = test_rmse

print(f"\nBeste modell basert på test-MAE: {best_model_name}")
print(f"Test MAE:  {best_test_mae:,.0f} USD")
print(f"Test RMSE: {best_test_rmse:,.0f} USD")


example = x_test.iloc[[0]]

prediction = best_model.predict(example)[0]
actual_price = y_test.iloc[0]

print("\n========== EKSEMPEL PÅ PRISESTIMAT ==========")

print("\nBilens egenskaper:")
print(example.to_string(index=False))

print(f"\nModell brukt:         {best_model_name}")
print(f"Estimert pris:        {prediction:,.0f} USD")
print(f"Faktisk annonsepris:  {actual_price:,.0f} USD")
print(f"Absolutt feil:        {abs(prediction - actual_price):,.0f} USD")


print("\n========== OPPSUMMERING ==========")

print(f"Annonser brukt: {len(df):,}")
print(f"Treningsannonser: {len(x_train):,}")
print(f"Testannonser: {len(x_test):,}")
print("Modeller sammenlignet: Random Forest og Extra Trees")
print(f"Beste modell: {best_model_name}")
print(f"Beste test-MAE: {best_test_mae:,.0f} USD")
print(f"Beste test-RMSE: {best_test_rmse:,.0f} USD")
print("Antall trær per modell: 300")
print("Random Forest maksimal tre-dybde: 25")
print("Minimum observasjoner per blad: 5")
